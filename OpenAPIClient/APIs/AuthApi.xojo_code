		  // Operation totp_setup
		  // Set up TOTP two-factor authentication (generates secret + backup codes)
		  // - 
		  //
		  // Invokes AuthApiCallbackHandler.TotpSetupCallback(TotpSetupResponse) on completion. 
		  //
		  // - GET /auth/totp/setup
		  // - defaultResponse: Nil
		  //
		  // - Bearer Token:
		  //   - type: http
		  //   - name: bearer_token
		  //
		  
		  Dim localVarHTTPSocket As New HTTPSecureSocket
		  Me.PrivateFuncPrepareSocket(localVarHTTPSocket)
		  
		  
		  
		  


		  Dim localVarPath As String = "/auth/totp/setup"
		  
		  
		  
		  AddHandler localVarHTTPSocket.PageReceived, addressof me.TotpSetup_handler
		  AddHandler localVarHTTPSocket.Error, addressof Me.TotpSetup_error
		  
		  
		  localVarHTTPSocket.SendRequest("GET", Me.BasePath + localVarPath)
		  if localVarHTTPSocket.LastErrorCode <> 0 then
		    Dim localVarException As New OpenAPIClient.OpenAPIClientException(localVarHTTPSocket.LastErrorCode)
			Raise localVarException
		  end if
		  
		End Sub
