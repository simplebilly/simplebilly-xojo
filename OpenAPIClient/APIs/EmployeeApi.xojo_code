	#tag Method, Flags = &h21
		Private Sub UpdateEmployee_error(sender As HTTPSecureSocket, Code As Integer)
		  If sender <> nil Then sender.Close()

		  Dim error As New OpenAPIClient.OpenAPIClientException(Code)
		  Dim data As OpenAPIClient.Models.Employee
		  CallbackHandler.UpdateEmployeeCallback(error, data)
