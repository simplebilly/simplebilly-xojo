		Sub AccountErasure()
		  // Operation account_erasure
		  // Erase ALL personal data of the tenant (TOS §11: deletion 90 days after termination).
		  // - 
		  //
		  // Invokes GdprApiCallbackHandler.AccountErasureCallback(Variant) on completion. 
		  //
		  // - POST /api/v1/gdpr/account-erasure
